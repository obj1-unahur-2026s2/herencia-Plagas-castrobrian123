import example.*

const hogar = new Hogar(
    nivelDeMugre = 20,
    nivelDeConfort = 50
)

const huerta = new Huerta(
    capacidadDeProduccion = 150,
    nivelDeHuertas = 2
)

const mascota = new Mascota(
    nivelDeSalud = 300
)

const barrio = new Barrio(
    elemento = [hogar, huerta, mascota]
)

//

const cucarachas = new Cucarachas(
    poblacion = 30,
    pesoPromedio = 8
)

const pulgas = new Pulgas(
    poblacion = 20
)

const garrapatas = new Garrapatas(
    poblacion = 20
)

const mosquitos = new Mosquitos(
    poblacion = 12
)

describe "Nivel de daño" {

    test "las cucarachas hacen la mitad de su población" {
        assert.equals(15, cucarachas.nivelDeDanio())
    }

    test "las pulgas hacen el doble de su población" {
        assert.equals(40, pulgas.nivelDeDanio())
    }

    test "las garrapatas hacen el doble de su población" {
        assert.equals(40, garrapatas.nivelDeDanio())
    }

    test "los mosquitos hacen daño equivalente a su población" {
        assert.equals(12, mosquitos.nivelDeDanio())
    }

}

describe "Transmisión de enfermedades" {

    test "las cucarachas de menos de 10 gramos no transmiten" {
        assert.notThat(cucarachas.transmiteEnfermedad())
    }

    test "las garrapatas transmiten si tienen al menos 10" {
        assert.that(garrapatas.transmiteEnfermedad())
    }

    test "12 mosquitos transmiten porque es múltiplo de 3" {
        assert.that(mosquitos.transmiteEnfermedad())
    }

}

